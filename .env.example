# PyFinFlow - Variables de Entorno
# Copia este archivo como .env y completa los valores

# --- Database ---
# PostgreSQL (producción) o SQLite (desarrollo local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pyfinflow_dev

# --- Redis ---
# Para cache de sesiones, rate limiting y queries frecuentes
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Clave secreta para firmar tokens JWT (cambiar en producción)
JWT_SECRET=change-me-in-production

# --- App ---
# development | production | testing
ENVIRONMENT=development

# --- Email Alerts (opcional) ---
# SMTP config para alertas de errores críticos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
ALERT_EMAIL_TO=admin@example.com

# --- HuggingFace (opcional - para IA en la nube) ---
# Obtén tu token en: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# --- AI Providers ---
# Prioridad de providers (se intenta en orden, fallback automático)
# Opciones: ollama, huggingface, gemini
AI_PROVIDER_PRIORITY=ollama,huggingface,gemini

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# HuggingFace (cloud)
HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# Gemini (cloud) - Obtén key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ChromaDB (vector store)
CHROMADB_PATH=./chroma_data

# IA Settings
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7
AI_CONTEXT_WINDOW=20
AI_RATE_LIMIT_PER_MIN=30

# --- Supabase (opcional - legado) ---
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
